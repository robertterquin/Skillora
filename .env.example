# Skillora Environment Variables Template
# Copy this file to .env or set these in your deployment dashboard (e.g. Vercel / Netlify / Railway)

# 1. Supabase Client Credentials (Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2. Supabase Server Service Role Key (Required for backend auto-enrollment, skill upserts in /api/ai/owl-chat,
#    and the email unsubscribe link in /api/reminders/unsubscribe)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. OpenAI API Key & Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Model selection (defaults to gpt-6-luna with fallback to gpt-4o-mini; options: gpt-6-luna, gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-6-luna

# 4. Email reminders: these are Supabase edge-function secrets, not Next.js env vars.
#    Set them with `supabase secrets set ...` (see README, "Email reminders and weekly recap").
#    RESEND_API_KEY, EMAIL_FROM, SITE_URL, CRON_SECRET
#    Show the email-reminder settings only once a sending domain is verified in Resend
#    (until then Resend delivers only to the account owner):
NEXT_PUBLIC_EMAIL_REMINDERS=off

# 5. Daily AI requests per signed-in learner (default 100). If you change it, also run
#    `supabase secrets set AI_DAILY_LIMIT=<n>` so the edge function uses the same number.
AI_DAILY_LIMIT=100

# 6. Contact email shown on /privacy and /terms. Leave empty until you have one to publish.
NEXT_PUBLIC_CONTACT_EMAIL=
